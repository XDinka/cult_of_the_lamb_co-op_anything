<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>COTLMP</AssemblyName>
    <Product>Cult of the Lamb Multiplayer Mod Plug-In</Product>
    <Version>0.9.0</Version>
    <Copyright>Copyright (c) 2026 GeoB99 &amp; Neco-Arc</Copyright>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>COTLMP</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="COTL_API" Version="0.3.4" />
    <PackageReference Include="CultOfTheLamb.GameLibs" Version="1.5.15.979-r.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.16" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The game's Managed folder, for the Steamworks.NET build the game ships (pass -p:CotlManagedDir=... to override) -->
    <CotlManagedDir Condition="'$(CotlManagedDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Cult of the Lamb\Cult Of The Lamb_Data\Managed</CotlManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="com.steamworks.net">
      <HintPath>$(CotlManagedDir)\com.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The game's input and session library (the title screen's engagement, for the test harness) -->
    <Reference Include="UnifyLibrary">
      <HintPath>$(CotlManagedDir)\UnifyLibrary.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The game's Arabic shaping (joining and turning), for the boxes the mod draws itself -->
    <Reference Include="RTLTMPro">
      <HintPath>$(CotlManagedDir)\RTLTMPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The main menu's "x CO-OP ANYTHING" under the game's logo (tools/make-menu-title.py draws it from the cover) -->
    <EmbeddedResource Include="Assets\coop-anything.png" LogicalName="coop-anything.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mod packages of releases, opened in the game (the game ships it) -->
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\COTLMPServer\COTLMPServer.csproj" />
  </ItemGroup>
</Project>
